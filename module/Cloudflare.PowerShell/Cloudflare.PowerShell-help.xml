    <command:details>
      <command:name>Get-CfDnsRecord</command:name>
      <command:verb>Get</command:verb>
      <command:noun>CfDnsRecord</command:noun>
      <maml:description>
        <maml:para>Gets Cloudflare DNS records.</maml:para>
      </maml:description>
    </command:details>
    <maml:description>
      <maml:para>Gets one or more typed DNS records through the shared runtime.</maml:para>
    </maml:description>
  </command:command>
  <command:command xmlns:maml="http://schemas.microsoft.com/maml/2004/10" xmlns:command="http://schemas.microsoft.com/maml/dev/command/2004/10" xmlns:dev="http://schemas.microsoft.com/maml/dev/2004/10" xmlns:MSHelp="http://msdn.microsoft.com/mshelp">
    <command:details>
      <command:name>Get-CfZone</command:name>
      <command:verb>Get</command:verb>
      <command:noun>CfZone</command:noun>
      <maml:description>
        <maml:para>Gets Cloudflare zones.</maml:para>
      </maml:description>
    </command:details>
    <maml:description>
      <maml:para>Gets zones visible to the authenticated account and writes one typed zone per pipeline object.</maml:para>
    </maml:description>
  </command:command>
  <command:command xmlns:maml="http://schemas.microsoft.com/maml/2004/10" xmlns:command="http://schemas.microsoft.com/maml/dev/command/2004/10" xmlns:dev="http://schemas.microsoft.com/maml/dev/2004/10" xmlns:MSHelp="http://msdn.microsoft.com/mshelp">
    <command:details>
      <command:name>New-CfDnsRecord</command:name>

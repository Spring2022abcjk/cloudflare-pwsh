      <command:noun>CfDnsRecord</command:noun>
      <maml:description>
        <maml:para>Creates a Cloudflare DNS record.</maml:para>
      </maml:description>
    </command:details>
    <maml:description>
      <maml:para>Creates a typed DNS record using the generated request model.</maml:para>
    </maml:description>
  </command:command>
  <command:command xmlns:maml="http://schemas.microsoft.com/maml/2004/10" xmlns:command="http://schemas.microsoft.com/maml/dev/command/2004/10" xmlns:dev="http://schemas.microsoft.com/maml/dev/2004/10" xmlns:MSHelp="http://msdn.microsoft.com/mshelp">
    <command:details>
      <command:name>Remove-CfDnsRecord</command:name>
      <command:verb>Remove</command:verb>
      <command:noun>CfDnsRecord</command:noun>

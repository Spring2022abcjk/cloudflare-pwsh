# Research snapshots and upstream SDK checkouts are local evidence only.
/ref/*
!/ref/.gitkeep

# .NET build output
**/bin/
**/obj/

# PowerShell/editor noise
*.user
*.suo
.vs/

# Test output
TestResults/
artifacts/
!artifacts/
!artifacts/projection/
!artifacts/projection/CmdletModel.json

# Local module build copy (recreated by the test runner)
module/**/*.dll

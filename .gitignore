# Research snapshots and upstream SDK checkouts are local evidence only.
/ref/*
!/ref/.gitkeep

# .NET build output
**/bin/
**/obj/

# PowerShell/editor noise
*.user
*.suo
.vs/

# Test output
TestResults/
artifacts/
!artifacts/
!artifacts/projection/
!artifacts/projection/CmdletModel.json
!artifacts/generated-normalized/
!artifacts/generated-normalized/dns-records/
!artifacts/generated-normalized/dns-records/*.json
/artifacts/p2.1/

# Local module build copy (recreated by the test runner)
module/**/*.dll
